-- Hàm tạo Toggle Button chuẩn
local function createToggle(name, callback)
    local ToggleFrame = Instance.new("Frame")
    ToggleFrame.Parent = Container
    ToggleFrame.BackgroundColor3 = Color3.fromRGB(20, 35, 60)
    ToggleFrame.BackgroundTransparency = 0.3
    ToggleFrame.Size = UDim2.new(1, 0, 0, 45)
    ToggleFrame.ZIndex = 2
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = ToggleFrame
    
    local Label = Instance.new("TextLabel")
    Label.Parent = ToggleFrame
    Label.BackgroundTransparency = 1
    Label.Position = UDim2.new(0, 12, 0, 0)
    Label.Size = UDim2.new(0, 180, 1, 0)
    Label.ZIndex = 2
    Label.Font = Enum.Font.GothamMedium
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(230, 240, 255)
    Label.TextSize = 14
    Label.TextXAlignment = Enum.TextXAlignment.Left
    
    local Button = Instance.new("TextButton")
    Button.Parent = ToggleFrame
    Button.BackgroundColor3 = Color3.fromRGB(40, 60, 90)
    Button.Position = UDim2.new(1, -55, 0.5, -12)
    Button.Size = UDim2.new(0, 45, 0, 24)
    Button.ZIndex = 2
    Button.Font = Enum.Font.GothamBold
    Button.Text = "OFF"
    Button.TextColor3 = Color3.fromRGB(255, 100, 100)
    Button.TextSize = 12
    
    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 12)
    BtnCorner.Parent = Button
    
    local toggled = false
    Button.MouseButton1Click:Connect(function()
        toggled = not toggled
        if toggled then
            Button.Text = "ON"
            Button.TextColor3 = Color3.fromRGB(100, 255, 100)
            Button.BackgroundColor3 = Color3.fromRGB(40, 140, 90)
        else
            Button.Text = "OFF"
            Button.TextColor3 = Color3.fromRGB(255, 100, 100)
            Button.BackgroundColor3 = Color3.fromRGB(40, 60, 90)
        end
        callback(toggled)
    end)
end

